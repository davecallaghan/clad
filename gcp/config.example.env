# Copy to gcp/config.env and fill in, then:  source gcp/config.env
# (gcp/config.env is gitignored so your project id doesn't get committed.)

# Your Google Cloud project id.
export GCP_PROJECT_ID="your-project-id"

# Globally-unique bucket name. Convention: clad-landing-<project-id>.
export GCS_BUCKET_NAME="clad-landing-your-project-id"

# Location for the bucket. A single region (e.g. us-central1, europe-west1)
# is cheapest; "US"/"EU" multi-region is more durable. Used only at creation.
export GCP_REGION="us-central1"
